---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "YT-Scribe 📝 | YouTube Transcript Extractor", 
	description = "Paste any YouTube URL to extract text transcripts instantly. Save your transcription history in your browser for offline reference."
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,700;0,800;1,400;1,700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-neo-bg text-black min-h-screen">
		<slot />
	</body>
</html>

